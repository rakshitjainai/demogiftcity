    "wp_rlcmi_progress": "One row per learner per item. FIRST-ATTEMPT SCORE OF RECORD - never overwrite. Keyed by user_id + item_uid.",
    "wp_rlcmi_responses": "Every attempt, including reviews. is_review=1 marks a refresher that must not affect scoring.",
    "wp_rlcmi_certificates": "Issued certificates. serial_no is the public verification key - must stay unique and stable."
   },
   "storage": {
    "storage": "Content is stored as WordPress custom post types: rlcmi_course, rlcmi_chapter, rlcmi_lesson, rlcmi_question (with postmeta _rlcmi_uid, _rlcmi_payload, _rlcmi_answer, _rlcmi_prov, _rlcmi_src, _rlcmi_eff, _rlcmi_chapter_no, _rlcmi_item_type).",
    "learners": "Learners are native WordPress users with the role rlcmi_learner. Their data sits in wp_users / wp_usermeta (_rlcmi_category, _rlcmi_mobile, _rlcmi_xp, _rlcmi_streak_count, _rlcmi_streak_date, _rlcmi_email_verified, _rlcmi_completed_at, _rlcmi_current_item).",
