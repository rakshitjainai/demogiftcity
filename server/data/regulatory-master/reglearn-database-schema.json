 "export_sql": [
  {
   "plugin": "CMI",
   "sql": "SELECT * FROM wp_rlcmi_progress;"
  },
  {
   "plugin": "CMI",
   "sql": "SELECT * FROM wp_rlcmi_responses;"
  },
  {
   "plugin": "CMI",
   "sql": "SELECT * FROM wp_rlcmi_certificates;"
  },
  {
   "plugin": "CMI",
   "sql": "SELECT u.ID, u.user_login, u.user_email, u.display_name, u.user_registered FROM wp_users u INNER JOIN wp_usermeta m ON m.user_id=u.ID AND m.meta_key='wp_capabilities' WHERE m.meta_value LIKE '%rlcmi_learner%';"
  },
  {
   "plugin": "CMI",
   "sql": "SELECT user_id, meta_key, meta_value FROM wp_usermeta WHERE meta_key LIKE '_rlcmi_%';"
  },
  {
   "plugin": "CMI",
   "sql": "SELECT option_name, option_value FROM wp_options WHERE option_name LIKE 'rlcmi_%';"
  },
  {
